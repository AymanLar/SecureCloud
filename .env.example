# Copy this file to .env (never commit .env) and change the values.
# Use URL-safe characters in POSTGRES_PASSWORD (letters, digits, _ - only).

POSTGRES_USER=securecloud
POSTGRES_PASSWORD=change-me-before-running
POSTGRES_DB=securecloud

# Optional overrides
CORS_ORIGINS=http://localhost:3000
ENVIRONMENT=development
NEXT_PUBLIC_API_URL=http://localhost:8000
